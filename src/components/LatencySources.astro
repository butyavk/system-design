---
// Renders the verified source list from src/data/latency.ts
// (used on /reference/latency-numbers/ under "Sources").
import { latencySources } from '~/data/latency';

const locale = Astro.locals.starlightRoute?.locale === 'ru' ? 'ru' : 'en';
const checked = locale === 'ru' ? 'Ссылки проверены 8 октября 2026 года.' : 'Links checked on 8 October 2026.';
---

<div class="lsrc not-content">
  <ol class="lsrc-list">
    {latencySources.map((s) => (
      <li>
        {s.url ? (
          <a href={s.url} rel="noopener">{s.title}</a>
        ) : (
          <span class="lsrc-title">{s.title}</span>
        )}
        <span class="lsrc-used">{s.used[locale]}</span>
      </li>
    ))}
  </ol>
  <p class="lsrc-note">{checked}</p>
</div>

<style>
  .lsrc { margin-block: 1rem; font-size: var(--sl-text-sm); }
  .lsrc-list {
    margin: 0;
    padding-left: 1.6rem;
    display: grid;
    gap: 0.45rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
  .lsrc-list li { margin: 0; padding-left: 0.2rem; overflow-wrap: anywhere; }
  .lsrc-list li::marker { color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; }
  .lsrc-list a { color: var(--sl-color-text-accent); }
  .lsrc-title { color: var(--sl-color-white); }
  .lsrc-used { display: block; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .lsrc-note { margin: 0.75rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
</style>
