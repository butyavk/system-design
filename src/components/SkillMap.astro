---
// Skill map: every topic as a node in a prerequisite graph, grouped by stage and section.
// Shows what is learned, opened, ready, skipped ("gaps"), where the reader is and what to
// read next. Selecting a node draws its prerequisites and what it unlocks.
// Server-rendered as plain links (works without JS); the script adds state and wiring.
import { stages, tracks } from '~/data/skill-map';
import { mapNodes, pageHref } from './lib/skill-map-data';
import { overviewLayout } from './lib/skill-map-layout';
import type { Locale } from './lib/format';
import '@fontsource-variable/cormorant';
import './skill-map-grim.css';

const locale: Locale = Astro.locals.starlightRoute?.locale === 'ru' ? 'ru' : 'en';
const nodes = await mapNodes(locale);
const href = (p: string) => pageHref(p, locale);

const T = {
  en: {
    learned: 'topics learned',
    here: 'You are here',
    notStarted: 'Not started yet.',
    start: 'Start with the introduction',
    next: 'Next up',
    gaps: 'Skipped',
    gapsHelp: 'Prerequisites of topics you have learned',
    plan: 'Show',
    all: 'All topics',
    short: 'Short plan',
    medium: 'Medium plan',
    long: 'Long plan',
    reset: 'Reset progress',
    confirm: 'Clear all progress on the map and in the study plan?',
    legend: 'Legend',
    lLearned: 'learned',
    lOpened: 'opened',
    lReady: 'ready to start',
    lLocked: 'read prerequisites first',
    lGap: 'skipped',
    lOut: 'not in this plan',
    saved: 'Progress is saved in this browser only and shared with the study plan. Pages you open are marked “opened”; mark a topic as learned at the end of its page or here.',
    nojs: 'Turn on JavaScript to see your progress and the connections between topics.',
    ovAria: 'Overview of all topics and their prerequisites',
    ovHint: 'Left to right: from the basics to the topics that build on them. Lines are prerequisites; select a topic to see what it needs and what it unlocks.',
    full: 'Full screen',
    exitFull: 'Exit full screen',
    listHead: 'By stage',
    keyAria: 'Sections',
    download: 'Download progress',
    load: 'Load progress',
    skin: 'Map look',
    classic: 'Classic',
    grim: 'Dark fantasy',
    nextGrim: 'Next quests',
    levelGrim: 'level',
  },
  ru: {
    learned: 'тем изучено',
    here: 'Вы здесь',
    notStarted: 'Вы ещё не начали.',
    start: 'Начните с введения',
    next: 'Дальше',
    gaps: 'Пропущено',
    gapsHelp: 'Темы, на которые опираются уже изученные',
    plan: 'Показать',
    all: 'Все темы',
    short: 'Короткий план',
    medium: 'Средний план',
    long: 'Длинный план',
    reset: 'Сбросить прогресс',
    confirm: 'Удалить весь прогресс на карте и в плане подготовки?',
    legend: 'Обозначения',
    lLearned: 'изучено',
    lOpened: 'открыто',
    lReady: 'можно начинать',
    lLocked: 'сначала нужные темы',
    lGap: 'пропущено',
    lOut: 'нет в этом плане',
    saved: 'Прогресс хранится только в этом браузере и общий с планом подготовки. Открытые страницы отмечаются как «открыто»; отметить тему изученной можно в конце её страницы или здесь.',
    nojs: 'Включите JavaScript, чтобы видеть прогресс и связи между темами.',
    ovAria: 'Обзор всех тем и связей между ними',
    ovHint: 'Слева направо — от основ к темам, которые на них опираются. Линии — зависимости; выберите тему, чтобы увидеть, что ей нужно и что она открывает.',
    full: 'На весь экран',
    exitFull: 'Свернуть',
    listHead: 'По этапам',
    keyAria: 'Разделы',
    download: 'Скачать прогресс',
    load: 'Загрузить прогресс',
    skin: 'Вид карты',
    classic: 'Обычная',
    grim: 'Тёмное фэнтези',
    nextGrim: 'Следующие задания',
    levelGrim: 'уровень',
  },
}[locale];

// Strings the script needs.
const C = {
  en: {
    of: 'of', min: 'min read', core: 'In every plan', medium: 'Medium and long plans', long: 'Long plan only', noPlan: 'Not a plan step',
    mark: 'Mark as learned', unmark: 'Learned — undo', open: 'Open the page', before: 'Read first', leads: 'Leads to',
    noNeeds: 'Nothing — a good place to start.', endLine: 'Nothing directly: this is an end point.', allBefore: 'Prerequisites learned, counting indirect ones',
    st: { learned: 'Learned', opened: 'Opened, not marked as learned', ready: 'Ready: every prerequisite is learned', locked: 'Prerequisites not learned yet', gap: 'Skipped: a topic you learned builds on it' },
    done: 'Everything in this plan is learned. Keep practising out loud.', more: 'more', here: 'You are here', none: 'none',
    cont: 'Continue reading', show: 'Show on the map', close: 'Close',
    io: { bad: 'This is not a progress file from this site.', replace: 'Replace the progress in this browser with the one from the file?', loaded: 'Progress loaded.', saved: 'Progress file saved.' },
    grim: { before: 'Requires', leads: 'Unlocks', mark: 'Learn this skill', unmark: 'Learned — undo', open: 'Open the page' },
  },
  ru: {
    of: 'из', min: 'мин чтения', core: 'Во всех планах', medium: 'Средний и длинный планы', long: 'Только длинный план', noPlan: 'Не шаг плана',
    mark: 'Отметить изученным', unmark: 'Изучено — отменить', open: 'Открыть страницу', before: 'Сначала прочитать', leads: 'Ведёт к',
    noNeeds: 'Ничего — хорошее место для старта.', endLine: 'Прямых продолжений нет: это конечная точка.', allBefore: 'Изучено нужных тем, включая косвенные',
    st: { learned: 'Изучено', opened: 'Открыто, но не отмечено изученным', ready: 'Можно начинать: все нужные темы изучены', locked: 'Нужные темы ещё не изучены', gap: 'Пропущено: на эту тему опирается уже изученная' },
    done: 'Всё в этом плане изучено. Продолжайте тренироваться вслух.', more: 'ещё', here: 'Вы здесь', none: 'нет',
    cont: 'Продолжить чтение', show: 'Показать на карте', close: 'Закрыть',
    io: { bad: 'Это не файл прогресса с этого сайта.', replace: 'Заменить прогресс в этом браузере данными из файла?', loaded: 'Прогресс загружен.', saved: 'Файл с прогрессом сохранён.' },
    grim: { before: 'Требует', leads: 'Открывает', mark: 'Изучить навык', unmark: 'Изучено — отменить', open: 'Открыть страницу' },
  },
}[locale];

const trackTitle = Object.fromEntries(tracks.map((t) => [t.id, t.title[locale]]));
const stageOfTrack = Object.fromEntries(stages.flatMap((s, i) => s.tracks.map((t) => [t, i])));
const clientData = {
  nodes: nodes.map((n) => ({ p: n.p, t: n.t, title: n.title, d: n.d, tr: n.tr, needs: n.needs, deps: n.deps, plans: n.plans, ord: n.ord, min: n.min, h: href(n.p) })),
  tracks: trackTitle,
  stages: stages.map((s) => s.title[locale]),
  stageOfTrack,
  t: C,
};
const nodeByPath = Object.fromEntries(nodes.map((n) => [n.p, n]));
const ov = overviewLayout((p) => nodeByPath[p].t);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
// One sigil per section for the dark-fantasy look (24×24, stroked).
const sigils: Record<string, string> = {
  start: 'M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7M7 4a2 2 0 0 0-2 2v1h4V6a2 2 0 0 0-2-2zM7 20a2 2 0 0 1-2-2v-1h4v1a2 2 0 0 1-2 2zM10 9h6M10 13h6',
  reference: 'M7 3h10M7 21h10M8 3c0 5 8 5 8 9s-8 4-8 9M16 3c0 5-8 5-8 9s8 4 8 9',
  fundamentals: 'M12 4v16M8 20h8M5 7h14M5 7l-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z',
  traffic: 'M12 3v18M5 5h11l3 2.5-3 2.5H5zM19 12H8l-3 2.5L8 17h11z',
  data: 'M5 6c0 1.7 3.1 3 7 3s7-1.3 7-3-3.1-3-7-3-7 1.3-7 3zM5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3',
  caching: 'M13 2 4 14h7l-1 8 9-12h-7z',
  async: 'M10 14a4 4 0 0 1 0-5.7l3-3a4 4 0 0 1 5.7 5.7l-1.5 1.5M14 10a4 4 0 0 1 0 5.7l-3 3a4 4 0 0 1-5.7-5.7l1.5-1.5',
  communication: 'M3 10v4h3l7 5V5L6 10zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12',
  architecture: 'M5 21V8l2-1V4h2v2h2V4h2v2h2V4h2v3l2 1v13zM10 21v-4a2 2 0 0 1 4 0v4',
  reliability: 'M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6zM9 12l2 2 4-4',
  practice: 'M4 3l9.5 9.5M20 3l-9.5 9.5M8 15l-3.5 3.5M16 15l3.5 3.5M6.5 13.5l4 4M17.5 13.5l-4 4M3 21l1.5-2.5M21 21l-1.5-2.5',
  ood: 'M12 3 4 7v10l8 4 8-4V7zM4 7l8 4 8-4M12 11v10',
  'real-world': 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11M9 8h6',
};
const plans = [
  ['all', T.all],
  ['short', T.short],
  ['medium', T.medium],
  ['long', T.long],
] as const;
---

<div class="sm not-content" data-sm data-skin="classic">
  <script is:inline>
    // Apply the saved look before first paint, so the map does not flash.
    (function (root) {
      try {
        var q = new URLSearchParams(location.search).get('skin');
        var v = q === 'grim' || q === 'classic' ? q : localStorage.getItem('sdp-map-skin');
        if (v === 'grim') root.dataset.skin = 'grim';
      } catch (e) {}
    })(document.currentScript.parentElement);
  </script>
  <script type="application/json" data-sm-json set:html={JSON.stringify(clientData)} />
  <svg class="sm-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    {Object.entries(sigils).map(([id, d]) => (
      <symbol id={`sm-sigil-${id}`} viewBox="0 0 24 24"><path d={d} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    ))}
  </svg>

  <div class="sm-skinbar">
    <span class="sm-skinbar__label" aria-hidden="true">{T.skin}</span>
    <fieldset class="sm-plan sm-skin">
      <legend class="sm-sr">{T.skin}</legend>
      <label>
        <input type="radio" name="sm-skin" value="classic" checked />
        <span>{T.classic}</span>
      </label>
      <label>
        <input type="radio" name="sm-skin" value="grim" />
        <span>⚔ {T.grim}</span>
      </label>
    </fieldset>
  </div>
  <section class="sm-top" aria-label={locale === 'ru' ? 'Ваш прогресс' : 'Your progress'}>
    <div class="sm-stat">
      <div class="sm-orb" aria-hidden="true"><span class="sm-orb__liquid"></span></div>
      <p class="sm-stat__num"><b data-sm-learned>0</b> <span>/ <span data-sm-total>{nodes.length}</span></span></p>
      <p class="sm-stat__label"><span class="sm-c">{T.learned}</span><span class="sm-g">{T.levelGrim} · {T.learned}</span></p>
      <div class="sm-meter" aria-hidden="true"><span class="sm-meter__l" data-sm-ml></span><span class="sm-meter__o" data-sm-mo></span></div>
    </div>
    <div class="sm-cell">
      <p class="sm-k">{T.here}</p>
      <div data-sm-here>
        <p class="sm-here__empty">{T.notStarted} <a href={href('start/introduction/')}>{T.start}</a>.</p>
      </div>
    </div>
    <div class="sm-cell">
      <p class="sm-k"><span class="sm-c">{T.next}</span><span class="sm-g">{T.nextGrim}</span></p>
      <div class="sm-chips" data-sm-next>
        <a class="sm-chip" href={href('start/introduction/')}>{nodes[0].t}</a>
      </div>
    </div>
    <div class="sm-cell sm-cell--gaps" data-sm-gaps-wrap hidden>
      <p class="sm-k">{T.gaps} <span class="sm-k__help">· {T.gapsHelp}</span></p>
      <div class="sm-chips" data-sm-gaps></div>
    </div>
  </section>

  <div class="sm-bar">
    <fieldset class="sm-plan">
      <legend class="sm-sr">{T.plan}</legend>
      {plans.map(([id, label]) => (
        <label>
          <input type="radio" name="sm-plan" value={id} checked={id === 'all'} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>
    <ul class="sm-legend" aria-label={T.legend}>
      <li><span class="sm-glyph is-learned"></span>{T.lLearned}</li>
      <li><span class="sm-glyph is-opened"></span>{T.lOpened}</li>
      <li><span class="sm-glyph is-ready"></span>{T.lReady}</li>
      <li><span class="sm-glyph is-locked"></span>{T.lLocked}</li>
      <li><span class="sm-glyph is-gap"></span>{T.lGap}</li>
      <li data-sm-lout hidden><span class="sm-glyph is-out"></span>{T.lOut}</li>
    </ul>
  </div>
  <noscript><p class="sm-nojs">{T.nojs}</p></noscript>

  <section class="sm-ov" data-sm-ov aria-label={T.ovAria}>
    <div class="sm-ov__bar">
      <p class="sm-ov__hint">{T.ovHint}</p>
      <button type="button" class="sm-ov__full" data-sm-full data-on={T.full} data-off={T.exitFull} aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" /></svg>
        <span data-sm-full-label>{T.full}</span>
      </button>
    </div>
    <div class="sm-ov__scroll" data-sm-ov-scroll>
      <div class="sm-ov__canvas" data-sm-ov-canvas style={`width:${ov.width}px;height:${ov.height}px`}>
        <svg class="sm-ov__edges" width={ov.width} height={ov.height} viewBox={`0 0 ${ov.width} ${ov.height}`} aria-hidden="true" focusable="false">
          {ov.edges.map((e) => <path d={e.d} data-from={e.from} data-to={e.to} />)}
        </svg>
        {ov.nodes.map((o) => (
          <a class="sm-onode" href={href(o.p)} data-p={o.p} style={`left:${o.x}px;top:${o.y}px`} title={nodeByPath[o.p].title}>
            <span class="sm-rune" aria-hidden="true"><svg><use href={`#sm-sigil-${nodeByPath[o.p].tr}`} /></svg></span>
            <span class="sm-onode__t">{nodeByPath[o.p].t}</span>
          </a>
        ))}
      </div>
    </div>
    <ul class="sm-ov__key" aria-label={T.keyAria}>
      {tracks.map((tr) => (
        <li><svg aria-hidden="true"><use href={`#sm-sigil-${tr.id}`} /></svg>{tr.title[locale]}</li>
      ))}
    </ul>
  </section>

  <h2 class="sm-listhead">{T.listHead}</h2>

  <div class="sm-board" data-sm-board>
    <svg class="sm-wires" data-sm-wires aria-hidden="true" focusable="false">
      <defs>
        <marker id="sm-arrow-need" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 8 4 0 8z" /></marker>
        <marker id="sm-arrow-dep" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 8 4 0 8z" /></marker>
      </defs>
      <g data-sm-g></g>
    </svg>
    <ol class="sm-stages">
      {stages.map((st, si) => (
        <li class="sm-stage" data-stage={si}>
          <header class="sm-stage__head">
            <span class="sm-stage__n" aria-hidden="true"><span class="sm-c">{si + 1}</span><span class="sm-g">{roman[si]}</span></span>
            <h2 class="sm-stage__title">{st.title[locale]}</h2>
            <span class="sm-stage__count" data-sm-stage-count></span>
          </header>
          <p class="sm-stage__out">{st.outcome[locale]}</p>
          <div class="sm-tracks">
            {st.tracks.map((tr) => (
              <section class="sm-track" data-track={tr}>
                <h3 class="sm-track__title">
                  <span>{trackTitle[tr]}</span>
                  <span class="sm-track__count" data-sm-track-count></span>
                </h3>
                <ol class="sm-track__list">
                  {nodes
                    .filter((n) => n.tr === tr)
                    .map((n) => (
                      <li>
                        <a class="sm-node" href={href(n.p)} data-p={n.p} title={n.title !== n.t ? n.title : undefined}>
                          <span class="sm-glyph" aria-hidden="true"></span>
                          <span class="sm-rune" aria-hidden="true"><svg><use href={`#sm-sigil-${n.tr}`} /></svg></span>
                          <span class="sm-node__t">{n.t}</span>
                          <span class="sm-node__here" hidden>{C.here}</span>
                        </a>
                      </li>
                    ))}
                </ol>
              </section>
            ))}
          </div>
        </li>
      ))}
    </ol>
    <aside class="sm-detail" data-sm-detail hidden aria-live="polite"></aside>
  </div>

  <div class="sm-foot">
    <p class="sm-saved">{T.saved}</p>
    <div class="sm-io">
      <button type="button" class="sm-reset" data-sm-export>{T.download}</button>
      <button type="button" class="sm-reset" data-sm-import>{T.load}</button>
      <input type="file" accept="application/json,.json" data-sm-file hidden />
      <button type="button" class="sm-reset" data-sm-reset data-confirm={T.confirm}>{T.reset}</button>
      <p class="sm-io__msg" data-sm-io-msg aria-live="polite"></p>
    </div>
  </div>
</div>

<style is:global>
  :root:has(.sm) {
    --sl-content-width: 74rem;
  }
  .sm-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .sm:not([data-skin='grim']) :is(.sm-g, .sm-node .sm-rune, .sm-orb) {
    display: none;
  }
  .sm[data-skin='grim'] .sm-c {
    display: none;
  }
  .sm {
    --sm-gap: 1rem;
    --sm-node-bg: var(--sl-color-bg);
    container-type: inline-size;
    margin-block: 1.5rem 2rem;
  }
  .sm :where(p, ol, ul, h2, h3, h4) {
    margin: 0;
  }
  .sm ol,
  .sm ul {
    list-style: none;
    padding: 0;
  }
  .sm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Summary ---------- */
  .sm-top {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 1fr 1.4fr;
    gap: 0.75rem;
  }
  .sm-stat,
  .sm-cell {
    padding: 0.85rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }
  .sm-cell--gaps {
    grid-column: 1 / -1;
    border-color: color-mix(in srgb, var(--sdp-signal) 55%, var(--sl-color-gray-5));
    background: color-mix(in srgb, var(--sdp-signal-low) 60%, var(--sl-color-bg));
  }
  .sm-stat__num {
    font-size: 2rem;
    line-height: 1;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  .sm-stat__num span {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
  .sm-stat__label {
    margin-top: 0.3rem !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sm-meter {
    display: flex;
    height: 0.4rem;
    margin-top: 0.7rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
  }
  .sm-meter__l {
    background: var(--sl-color-accent);
  }
  .sm-meter__o {
    background: color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
  }
  .sm-k {
    margin-bottom: 0.45rem !important;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .sm-k__help {
    font-weight: 450;
    letter-spacing: 0;
    text-transform: none;
  }
  .sm-here__empty,
  .sm-here__title {
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }
  .sm-here__title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .sm-here__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin-top: 0.4rem;
    font-size: var(--sl-text-sm);
  }
  .sm-here__actions :is(a, button),
  .sm-here__empty a {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .sm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sm-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .sm-chip:hover,
  .sm-chip:focus-visible {
    border-color: var(--sl-color-accent);
  }
  .sm-chip--more {
    color: var(--sl-color-gray-3);
  }
  .sm-done {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  /* ---------- Controls ---------- */
  .sm-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin: 1.25rem 0 0.25rem;
  }
  .sm-plan {
    display: inline-flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
  }
  .sm-plan label {
    position: relative;
  }
  .sm-plan input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .sm-plan span {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .sm-plan input:checked + span {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
  .sm-plan input:focus-visible + span {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .sm-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .sm-legend li[hidden] {
    display: none;
  }
  .sm-nojs {
    margin-top: 0.75rem !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* ---------- Overview: the whole tree at once ---------- */
  .sm-ov {
    margin-top: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg);
    background-image: radial-gradient(var(--sl-color-gray-6) 1px, transparent 1.2px);
    background-size: 18px 18px;
  }
  .sm-ov__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0.9rem 0;
  }
  .sm-ov__hint {
    flex: 1 1 24rem;
    max-width: 62ch;
    font-size: var(--sl-text-sm);
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }
  .sm-ov__full {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .sm-ov__full svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .sm-ov__full:hover,
  .sm-ov__full:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .sm-ov__scroll {
    overflow: auto;
    overscroll-behavior-x: contain;
    padding: 0.25rem 0 0.5rem;
  }
  .sm-ov__canvas {
    position: relative;
    margin-inline: auto;
  }
  .sm-ov__edges {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  .sm-ov__edges path {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.4;
    transition: stroke 150ms, opacity 150ms;
  }
  .sm-ov__edges path.e-done {
    stroke: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-gray-5));
  }
  .sm.has-sel .sm-ov__edges path {
    opacity: 0.35;
  }
  .sm.has-sel .sm-ov__edges path:is(.e-need, .e-dep, .e-anc) {
    opacity: 1;
  }
  .sm-ov__edges path.e-anc {
    stroke: color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    stroke-width: 1.8;
  }
  .sm-ov__edges path.e-need {
    stroke: var(--sl-color-accent);
    stroke-width: 2.6;
  }
  .sm-ov__edges path.e-dep {
    stroke: var(--sdp-signal);
    stroke-width: 2.2;
    stroke-dasharray: 6 4;
  }
  /* Links to topics outside the chosen plan fade to a dotted trace. */
  .sm-ov__edges path.e-out:not(.e-need, .e-dep, .e-anc) {
    stroke-dasharray: 1.5 4.5;
    opacity: 0.6;
  }
  .sm-onode {
    position: absolute;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    width: 122px;
    transform: translate(-50%, -17px);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .sm-onode .sm-rune {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 2px solid var(--sl-color-gray-4);
    border-radius: 50%;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
    transition: box-shadow 150ms, border-color 150ms, background-color 150ms, transform 220ms ease;
  }
  .sm-onode .sm-rune svg {
    transition: opacity 150ms;
  }
  .sm-onode .sm-rune svg {
    width: 17px;
    height: 17px;
  }
  /* Sizes match OV.labelW / lineH / maxLines in skill-map-layout.ts, which leaves room for them. */
  .sm-onode__t {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 100%;
    padding: 0 1px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--sl-color-bg) 88%, transparent);
    font-size: 0.72rem;
    line-height: 14px;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .sm-onode.is-ready .sm-rune {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
  .sm-onode.is-locked .sm-rune {
    border-style: dashed;
  }
  .sm-onode.is-locked {
    color: var(--sl-color-gray-2);
  }
  .sm-onode.is-opened .sm-rune {
    border-color: var(--sl-color-accent);
    background: linear-gradient(90deg, var(--sl-color-accent-low) 50%, var(--sl-color-bg) 50%);
    color: var(--sl-color-accent);
  }
  .sm-onode.is-learned .sm-rune {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .sm-onode.is-gap .sm-rune {
    border-color: var(--sdp-signal);
    color: var(--sdp-signal);
    background: var(--sdp-signal-low);
  }
  /* Not in the chosen plan: the socket folds into a small dot and the tree keeps its shape.
     Pointing at it (or selecting it) unfolds it again. */
  .sm-onode.is-out {
    color: var(--sl-color-gray-3);
  }
  .sm-onode.is-out:not(.is-sel, :hover, :focus-visible) .sm-rune {
    transform: scale(0.36);
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-4);
    box-shadow: none;
  }
  .sm-onode.is-out.is-learned:not(.is-sel, :hover, :focus-visible) .sm-rune {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
  }
  .sm-onode.is-out:not(.is-sel, :hover, :focus-visible) .sm-rune svg {
    opacity: 0;
  }
  .sm.has-sel .sm-onode:not(.is-sel, .is-need, .is-anc, .is-dep) {
    color: var(--sl-color-gray-3);
  }
  .sm-onode.is-need .sm-rune,
  .sm-onode.is-anc .sm-rune {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
  }
  .sm-onode.is-dep .sm-rune {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sdp-signal) 35%, transparent);
  }
  .sm-onode.is-sel .sm-rune {
    box-shadow: 0 0 0 3px var(--sl-color-bg), 0 0 0 5px var(--sl-color-accent);
  }
  .sm-onode.is-sel .sm-onode__t {
    font-weight: 650;
  }
  .sm-onode.is-here .sm-rune::after {
    content: '';
    position: absolute;
    top: -5px;
    right: -5px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--sl-color-bg);
    border-radius: 50%;
    background: var(--sdp-signal);
  }
  .sm-onode:hover .sm-rune {
    border-color: var(--sl-color-gray-2);
  }
  .sm-onode:focus-visible {
    outline: none;
  }
  .sm-onode:focus-visible .sm-rune {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }
  .sm-ov .sm-ov__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    padding: 0.6rem 0.9rem 0.8rem;
    border-top: 1px solid var(--sl-color-gray-6);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .sm-ov__key li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .sm-ov__key svg {
    width: 14px;
    height: 14px;
  }
  /* The detail panel as a tooltip inside the overview. */
  .sm .sm-ov__canvas > .sm-detail.is-pop {
    position: absolute;
    z-index: 3;
    width: 19rem;
    max-height: calc(100% - 8px);
    overflow: auto;
  }
  .sm-d__close {
    position: absolute;
    top: 0.4rem;
    inset-inline-end: 0.5rem;
    width: 1.8rem;
    height: 1.8rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .sm-d__close:hover,
  .sm-d__close:focus-visible {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .sm-detail .sm-d__crumb {
    padding-inline-end: 2rem;
  }
  /* Full screen. */
  .sm-ov.is-full {
    position: fixed !important;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: 0;
  }
  .sm-ov.is-full .sm-ov__scroll {
    flex: 1;
  }
  :root.sm-noscroll {
    overflow: hidden;
  }
  /* Overlay fallback: let the fixed overview rise above the site header and sidebar. */
  :root.sm-noscroll :is(.main-pane, .sm, .sm > *) {
    isolation: auto !important;
    z-index: auto !important;
  }
  :root.sm-noscroll .sm-ov.is-full {
    z-index: 2147483000 !important;
  }
  .sm .sm-listhead {
    margin: 2rem 0 0.25rem;
    font-size: var(--sl-text-h4);
    font-weight: 650;
    color: var(--sl-color-white);
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-ov__edges path,
    .sm-onode .sm-rune,
    .sm-onode .sm-rune svg {
      transition: none;
    }
  }

  /* ---------- Board ---------- */
  .sm-board {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .sm.is-side.has-sel .sm-board {
    grid-template-columns: minmax(0, 1fr) 19rem;
    align-items: start;
  }
  .sm-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .sm-wires path {
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .sm-wires .w-need {
    stroke: var(--sl-color-accent);
    marker-end: url(#sm-arrow-need);
  }
  .sm-wires .w-dep {
    stroke: var(--sdp-signal);
    stroke-dasharray: 5 4;
    marker-end: url(#sm-arrow-dep);
  }
  #sm-arrow-need path {
    fill: var(--sl-color-accent);
  }
  #sm-arrow-dep path {
    fill: var(--sdp-signal);
  }
  .sm-stages {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .sm-stage {
    position: relative;
    padding-bottom: 1.1rem;
  }
  .sm-stage:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.95rem;
    bottom: 0;
    width: 2px;
    height: 0.9rem;
    background: var(--sl-color-gray-5);
  }
  .sm-stage__head,
  .sm-stage__out {
    position: relative;
    background: var(--sl-color-bg);
  }
  .sm-stage__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sm-stage__n {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--sl-color-accent);
    border-radius: 50%;
    background: var(--sl-color-bg);
    color: var(--sl-color-accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .sm-stage.is-complete .sm-stage__n {
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
  }
  .sm .sm-stage__title {
    margin: 0;
    padding: 0;
    font-size: var(--sl-text-lg);
    font-weight: 650;
    color: var(--sl-color-white);
  }
  .sm-stage__count {
    margin-inline-start: auto;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .sm-stage__out {
    margin: 0.2rem 0 0.7rem 2.6rem !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sm-tracks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: var(--sm-gap);
    margin-inline-start: 2.6rem;
  }
  .sm-track {
    min-width: 0;
    padding: 0.7rem 0.75rem 0.8rem;
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }
  .sm-track {
    background: color-mix(in srgb, var(--sl-color-bg) 82%, transparent);
  }
  .sm .sm-track__title {
    margin-top: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem !important;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .sm-track__count {
    flex: none;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .sm-track__list {
    display: grid;
    gap: 0.4rem;
  }
  .sm-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.55rem;
    background: var(--sm-node-bg);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 120ms, opacity 120ms, background-color 120ms;
  }
  .sm-node:hover {
    border-color: var(--sl-color-gray-3);
  }
  .sm-node:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sm-node__t {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .sm-node__here {
    flex: none;
    margin-inline-start: auto;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--sdp-signal);
    color: var(--sl-color-black);
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .sm-node.is-locked {
    color: var(--sl-color-gray-2);
  }
  .sm-node.is-gap {
    border-color: color-mix(in srgb, var(--sdp-signal) 70%, transparent);
  }
  /* Dimming changes colours, never opacity: nodes stay opaque so wires pass behind them. */
  .sm-node.is-out {
    border-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
  }
  /* Outside the chosen plan: the same folded dot as on the overview (learned ones keep their colour). */
  .sm-node.is-out > .sm-glyph {
    width: 0.45rem;
    height: 0.45rem;
    margin: 0.25rem;
    border-style: solid;
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-4);
  }
  .sm-node.is-out.is-learned > .sm-glyph {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
  }
  .sm-node.is-out > .sm-glyph::after {
    display: none;
  }
  .sm-node.is-need {
    border-color: var(--sl-color-accent);
  }
  .sm-node.is-anc:not(.is-need) {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
    border-style: dashed;
  }
  .sm-node.is-dep {
    border-color: var(--sdp-signal);
  }
  .sm-node.is-sel {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent-low) 75%, var(--sl-color-bg));
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }
  .sm.has-sel .sm-node:not(.is-sel, .is-need, .is-anc, .is-dep) {
    border-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
  }
  .sm.has-sel .sm-node:not(.is-sel, .is-need, .is-anc, .is-dep) .sm-glyph {
    opacity: 0.6;
  }

  /* ---------- Detail panel ---------- */
  .sm-detail {
    position: relative;
    z-index: 2;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.85rem;
    background: var(--sl-color-bg);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.5);
  }
  .sm.is-side .sm-detail {
    position: sticky;
    top: calc(var(--sl-nav-height, 4rem) + 1rem);
    max-height: calc(100vh - var(--sl-nav-height, 4rem) - 2rem);
    overflow: auto;
  }
  .sm-tracks > .sm-detail {
    grid-column: 1 / -1;
  }
  .sm-detail .sm-d__crumb {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .sm-detail .sm-d__title {
    margin: 0.25rem 0 0.4rem;
    font-size: var(--sl-text-xl);
    line-height: 1.2;
    font-weight: 650;
    color: var(--sl-color-white);
  }
  .sm-detail .sm-d__desc {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .sm-detail .sm-d__meta {
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .sm-detail .sm-d__status {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.8rem;
    padding: 0.55rem 0.65rem;
    border-radius: 0.55rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .sm-detail .sm-d__status .sm-glyph {
    margin-top: 0.15rem;
  }
  .sm-detail .sm-d__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .sm-detail .sm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .sm-detail .sm-btn--ghost {
    background: transparent;
    color: var(--sl-color-accent);
  }
  .sm-detail .sm-d__h {
    margin: 1rem 0 0.4rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .sm-detail .sm-d__h--need {
    color: var(--sl-color-accent);
  }
  .sm-detail .sm-d__h--dep {
    color: var(--sdp-signal);
  }
  .sm-detail .sm-d__list {
    display: grid;
    gap: 0.3rem;
  }
  .sm-detail .sm-d__list .sm-chip {
    width: 100%;
    border-radius: 0.5rem;
  }
  .sm-detail .sm-d__none,
  .sm-detail .sm-d__path {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sm-detail .sm-d__path {
    margin-top: 0.4rem;
  }

  /* ---------- Footer ---------- */
  .sm-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }
  .sm-saved {
    flex: 1 1 22rem;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .sm-skinbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }
  .sm-skinbar__label {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sm[data-skin='grim'] .sm-skinbar__label {
    color: var(--g-bone-dim);
  }
  .sm-io {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .sm-io__msg {
    flex-basis: 100%;
    min-height: 1.2em;
    font-size: var(--sl-text-xs);
    text-align: end;
    color: var(--sl-color-gray-3);
  }
  .sm-reset {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .sm-reset:hover,
  .sm-reset:focus-visible {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }

  @container (max-width: 44rem) {
    .sm-top {
      grid-template-columns: 1fr;
    }
    .sm-stat {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: 0.75rem;
    }
    .sm-meter {
      grid-column: 1 / -1;
    }
    .sm-tracks {
      margin-inline-start: 0;
    }
    .sm-stage__out {
      margin-inline-start: 0 !important;
    }
    .sm-stage:not(:last-child)::after {
      display: none;
    }
    .sm-plan {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      border-radius: 1rem;
    }
    .sm-plan span {
      text-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-node {
      transition: none;
    }
  }
</style>

<script>
  import { loadProgress, onProgressChange, saveProgress, setLearned, PROGRESS_KEY, type Progress } from './lib/progress';

  // Everything a reader may want to carry to another browser: map and plan progress,
  // flashcard boxes and the chosen views.
  const PORTABLE = [PROGRESS_KEY, 'sdp-study-plan', 'sdp-map-plan', 'sdp-map-skin', 'sdp-flashcards-en', 'sdp-flashcards-ru'];

  type N = { p: string; t: string; title: string; d: string; tr: string; needs: string[]; deps: string[]; plans: string[]; ord: number; min: number; h: string };
  type Data = { nodes: N[]; tracks: Record<string, string>; stages: string[]; stageOfTrack: Record<string, number>; t: any };
  type Status = 'learned' | 'opened' | 'ready' | 'locked' | 'gap';
  const PLAN_KEY = 'sdp-map-plan';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function readPlan(): string {
    try {
      const own = localStorage.getItem(PLAN_KEY);
      if (own) return own;
      const sp = JSON.parse(localStorage.getItem('sdp-study-plan') || '{}');
      if (sp && typeof sp.timeline === 'string') return sp.timeline;
    } catch {
      /* storage unavailable */
    }
    return 'all';
  }
  function writePlan(v: string) {
    try {
      localStorage.setItem(PLAN_KEY, v);
    } catch {
      /* ignore */
    }
  }

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const data = JSON.parse(root.querySelector('[data-sm-json]')!.textContent || '{}') as Data;
    const t = data.t;
    const byPath = new Map(data.nodes.map((n) => [n.p, n]));
    const els = new Map<string, HTMLAnchorElement>();
    root.querySelectorAll<HTMLAnchorElement>('.sm-node').forEach((a) => els.set(a.dataset.p!, a));
    // Overview: one socket per topic and one path per prerequisite link.
    const oels = new Map<string, HTMLAnchorElement>();
    root.querySelectorAll<HTMLAnchorElement>('.sm-onode').forEach((a) => oels.set(a.dataset.p!, a));
    const oedges = [...root.querySelectorAll<SVGPathElement>('.sm-ov__edges path')];
    const ovSection = root.querySelector<HTMLElement>('[data-sm-ov]')!;
    const ovScroll = root.querySelector<HTMLElement>('[data-sm-ov-scroll]')!;
    const ovCanvas = root.querySelector<HTMLElement>('[data-sm-ov-canvas]')!;
    // Where the last selection came from decides where the panel opens.
    let origin: 'ov' | 'list' = 'list';
    const board = root.querySelector<HTMLElement>('[data-sm-board]')!;
    const g = root.querySelector<SVGGElement>('[data-sm-g]')!;
    const detail = root.querySelector<HTMLElement>('[data-sm-detail]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="sm-plan"]')];

    let plan = readPlan();
    if (!radios.some((r) => r.value === plan)) plan = 'all';
    let progress: Progress = loadProgress();
    let selected: string | null = null;

    // Transitive prerequisites.
    const ancCache = new Map<string, Set<string>>();
    const ancestors = (p: string): Set<string> => {
      if (ancCache.has(p)) return ancCache.get(p)!;
      const out = new Set<string>();
      const walk = (q: string) => byPath.get(q)?.needs.forEach((d) => { if (!out.has(d)) { out.add(d); walk(d); } });
      walk(p);
      ancCache.set(p, out);
      return out;
    };
    const inPlan = (n: N) => plan === 'all' || n.plans.length === 0 || n.plans.includes(plan);
    const learned = (p: string) => !!progress.learned[p];

    function statuses(): Map<string, Status> {
      const gapSet = new Set<string>();
      for (const n of data.nodes) if (learned(n.p)) ancestors(n.p).forEach((a) => !learned(a) && gapSet.add(a));
      const m = new Map<string, Status>();
      for (const n of data.nodes) {
        if (learned(n.p)) m.set(n.p, 'learned');
        else if (gapSet.has(n.p)) m.set(n.p, 'gap');
        else if (progress.visited[n.p]) m.set(n.p, 'opened');
        else m.set(n.p, n.needs.every(learned) ? 'ready' : 'locked');
      }
      return m;
    }

    const chip = (n: N, st?: Status) =>
      `<button type="button" class="sm-chip" data-go="${esc(n.p)}">${st ? `<span class="sm-glyph is-${st}" aria-hidden="true"></span>` : ''}${esc(n.t)}</button>`;

    function planText(n: N) {
      if (!n.plans.length) return t.noPlan;
      if (n.plans.includes('short')) return t.core;
      if (n.plans.includes('medium')) return t.medium;
      return t.long;
    }

    // Labels for the detail panel: the dark-fantasy look renames a few of them.
    const L = () => (root.dataset.skin === 'grim' ? { ...t, ...t.grim } : t);

    function renderDetail(st: Map<string, Status>) {
      const t = L();
      if (!selected) {
        detail.hidden = true;
        return;
      }
      const n = byPath.get(selected)!;
      const s = st.get(n.p)!;
      const anc = [...ancestors(n.p)];
      const ancLearned = anc.filter(learned).length;
      const needs = n.needs.map((p) => byPath.get(p)!);
      const deps = n.deps.map((p) => byPath.get(p)!);
      detail.innerHTML = `
        <button type="button" class="sm-d__close" data-close aria-label="${esc(t.close)}">×</button>
        <p class="sm-d__crumb">${data.stageOfTrack[n.tr] + 1} · ${esc(data.stages[data.stageOfTrack[n.tr]])} / ${esc(data.tracks[n.tr])}</p>
        <h3 class="sm-d__title">${esc(n.title)}</h3>
        <p class="sm-d__desc">${esc(n.d)}</p>
        <p class="sm-d__meta">≈ ${n.min} ${t.min} · ${esc(planText(n))}</p>
        <p class="sm-d__status"><span class="sm-glyph is-${s}" aria-hidden="true"></span><span>${esc(t.st[s])}</span></p>
        <div class="sm-d__actions">
          <a class="sm-btn" href="${esc(n.h)}">${t.open} →</a>
          <button type="button" class="sm-btn sm-btn--ghost" data-toggle aria-pressed="${learned(n.p)}">${learned(n.p) ? t.unmark : t.mark}</button>
        </div>
        <h4 class="sm-d__h sm-d__h--need">${t.before}</h4>
        ${needs.length ? `<ul class="sm-d__list">${needs.map((x) => `<li>${chip(x, st.get(x.p))}</li>`).join('')}</ul>` : `<p class="sm-d__none">${t.noNeeds}</p>`}
        ${anc.length > needs.length ? `<p class="sm-d__path">${t.allBefore}: ${ancLearned} ${t.of} ${anc.length}</p>` : ''}
        <h4 class="sm-d__h sm-d__h--dep">${t.leads}</h4>
        ${deps.length ? `<ul class="sm-d__list">${deps.map((x) => `<li>${chip(x, st.get(x.p))}</li>`).join('')}</ul>` : `<p class="sm-d__none">${t.endLine}</p>`}`;
      detail.hidden = false;
      detail.style.left = detail.style.top = '';
      detail.classList.remove('is-pop');
      if (origin === 'ov') {
        // Overview: a tooltip next to the socket when there is room, else right under the map.
        if (ovScroll.clientWidth >= 560) {
          if (detail.parentElement !== ovCanvas) ovCanvas.append(detail);
          detail.classList.add('is-pop');
          const a = oels.get(n.p)!;
          const x = parseFloat(a.style.left);
          const y = parseFloat(a.style.top);
          const w = detail.offsetWidth;
          const right = x + 34 + w <= ovCanvas.offsetWidth;
          detail.style.left = `${right ? x + 34 : Math.max(4, x - 34 - w)}px`;
          const h = detail.offsetHeight;
          detail.style.top = `${Math.max(4, Math.min(y - 60, ovCanvas.offsetHeight - h - 4))}px`;
        } else if (ovSection.nextElementSibling !== detail) ovSection.after(detail);
        return;
      }
      // Lists: on narrow layouts show the panel right under the section that holds the node.
      if (!root.classList.contains('is-side')) {
        const track = els.get(n.p)!.closest('.sm-track')!;
        if (track.nextElementSibling !== detail) track.after(detail);
      } else if (detail.parentElement !== board) board.append(detail);
    }

    function render() {
      progress = loadProgress();
      const st = statuses();
      const sel = selected ? byPath.get(selected) : null;
      const anc = sel ? ancestors(sel.p) : new Set<string>();
      root.classList.toggle('has-sel', !!sel);
      let total = 0;
      let nLearned = 0;
      let nOpened = 0;
      for (const n of data.nodes) {
        const a = els.get(n.p)!;
        const s = st.get(n.p)!;
        for (const k of ['learned', 'opened', 'ready', 'locked', 'gap']) a.classList.toggle(`is-${k}`, k === s);
        const out = !inPlan(n);
        a.classList.toggle('is-out', out);
        a.classList.toggle('is-sel', n.p === selected);
        a.classList.toggle('is-need', !!sel && sel.needs.includes(n.p));
        a.classList.toggle('is-anc', anc.has(n.p));
        a.classList.toggle('is-dep', !!sel && sel.deps.includes(n.p));
        if (n.p === selected) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        a.querySelector<HTMLElement>('.sm-node__here')!.hidden = progress.last !== n.p;
        const o = oels.get(n.p);
        if (o) {
          o.className = a.className.replace('sm-node', 'sm-onode');
          o.classList.toggle('is-here', progress.last === n.p);
          if (n.p === selected) o.setAttribute('aria-current', 'true');
          else o.removeAttribute('aria-current');
        }
        if (!out) {
          total++;
          if (s === 'learned') nLearned++;
          else if (progress.visited[n.p]) nOpened++;
        }
      }
      // Counts per track and stage (within the chosen plan).
      root.querySelectorAll<HTMLElement>('.sm-track').forEach((tr) => {
        const list = data.nodes.filter((n) => n.tr === tr.dataset.track && inPlan(n));
        tr.querySelector('[data-sm-track-count]')!.textContent = `${list.filter((n) => learned(n.p)).length}/${list.length}`;
      });
      root.querySelectorAll<HTMLElement>('.sm-stage').forEach((sg) => {
        const i = Number(sg.dataset.stage);
        const list = data.nodes.filter((n) => data.stageOfTrack[n.tr] === i && inPlan(n));
        const d = list.filter((n) => learned(n.p)).length;
        sg.querySelector('[data-sm-stage-count]')!.textContent = `${d} ${t.of} ${list.length}`;
        sg.classList.toggle('is-complete', list.length > 0 && d === list.length);
      });
      root.querySelector('[data-sm-learned]')!.textContent = String(nLearned);
      root.querySelector('[data-sm-total]')!.textContent = String(total);
      root.querySelector<HTMLElement>('[data-sm-ml]')!.style.width = `${total ? (nLearned / total) * 100 : 0}%`;
      root.style.setProperty('--sm-p', String(total ? nLearned / total : 0));
      root.querySelector<HTMLElement>('[data-sm-mo]')!.style.width = `${total ? (nOpened / total) * 100 : 0}%`;

      // You are here.
      const here = root.querySelector<HTMLElement>('[data-sm-here]')!;
      const last = progress.last && byPath.get(progress.last);
      if (last) {
        here.innerHTML = `<p class="sm-here__title">${esc(last.title)}</p>
          <p class="sm-here__actions"><a href="${esc(last.h)}">${t.cont} →</a><button type="button" data-go="${esc(last.p)}">${t.show}</button></p>`;
      }

      // Next up: ready topics in plan order, from the earliest stage that has one and the
      // stage after it (so a topic with no prerequisites far down the map does not jump ahead).
      const ready = data.nodes
        .filter((n) => inPlan(n) && !learned(n.p) && st.get(n.p) !== 'gap' && n.needs.every(learned))
        .sort((a, b) => a.ord - b.ord);
      const firstStage = Math.min(...ready.map((n) => data.stageOfTrack[n.tr]));
      const next = ready.filter((n) => data.stageOfTrack[n.tr] <= firstStage + 1).slice(0, 3);
      const nextEl = root.querySelector<HTMLElement>('[data-sm-next]')!;
      nextEl.innerHTML = next.length ? next.map((n) => chip(n, st.get(n.p))).join('') : `<p class="sm-done">${t.done}</p>`;

      // Gaps.
      const gaps = data.nodes.filter((n) => st.get(n.p) === 'gap').sort((a, b) => a.ord - b.ord);
      const gw = root.querySelector<HTMLElement>('[data-sm-gaps-wrap]')!;
      gw.hidden = gaps.length === 0;
      const shown = gaps.slice(0, 8);
      root.querySelector<HTMLElement>('[data-sm-gaps]')!.innerHTML =
        shown.map((n) => chip(n, 'gap')).join('') + (gaps.length > shown.length ? `<span class="sm-chip sm-chip--more">+${gaps.length - shown.length} ${t.more}</span>` : '');

      // Overview links: what the selected topic needs, what it unlocks, and the path behind it.
      for (const e of oedges) {
        const f = e.dataset.from!;
        const to = e.dataset.to!;
        e.classList.toggle('e-need', !!sel && to === sel.p);
        e.classList.toggle('e-dep', !!sel && f === sel.p);
        e.classList.toggle('e-anc', !!sel && to !== sel.p && anc.has(to) && anc.has(f));
        e.classList.toggle('e-done', learned(f) && learned(to));
        e.classList.toggle('e-out', !inPlan(byPath.get(f)!) || !inPlan(byPath.get(to)!));
      }
      root.querySelector<HTMLElement>('[data-sm-lout]')!.hidden = plan === 'all';
      renderDetail(st);
      requestAnimationFrame(drawWires);
    }

    // ---------- Wires ----------
    function drawWires() {
      g.textContent = '';
      if (!selected) return;
      const n = byPath.get(selected)!;
      const box = board.getBoundingClientRect();
      const rect = (p: string) => {
        const r = els.get(p)!.getBoundingClientRect();
        return { l: r.left - box.left, r: r.right - box.left, t: r.top - box.top, b: r.bottom - box.top, cx: r.left - box.left + r.width / 2, cy: r.top - box.top + r.height / 2 };
      };
      const path = (from: string, to: string, cls: string, k: number) => {
        const a = rect(from);
        const b = rect(to);
        let d: string;
        if (Math.abs(a.cx - b.cx) < 8) {
          // Same column: bulge out to the left so the line does not run behind the nodes in between.
          const x = Math.min(a.l, b.l);
          const bend = 16 + k * 7;
          const y1 = a.cy;
          const y2 = b.cy;
          d = `M${x} ${y1} C${x - bend} ${y1} ${x - bend} ${y2} ${x - 2} ${y2}`;
        } else if (Math.abs(a.cy - b.cy) < Math.max(a.b - a.t, 24) && Math.abs(a.cx - b.cx) > 0) {
          // Same row: side to side.
          const [x1, x2] = a.cx < b.cx ? [a.r, b.l - 2] : [a.l, b.r + 2];
          const mx = (x1 + x2) / 2;
          d = `M${x1} ${a.cy} C${mx} ${a.cy} ${mx} ${b.cy} ${x2} ${b.cy}`;
        } else {
          const down = b.cy > a.cy;
          const y1 = down ? a.b : a.t;
          const y2 = down ? b.t - 2 : b.b + 2;
          const my = (y1 + y2) / 2;
          d = `M${a.cx} ${y1} C${a.cx} ${my} ${b.cx} ${my} ${b.cx} ${y2}`;
        }
        const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        el.setAttribute('d', d);
        el.setAttribute('class', cls);
        g.append(el);
      };
      n.needs.forEach((p, i) => path(p, n.p, 'w-need', i));
      n.deps.forEach((p, i) => path(n.p, p, 'w-dep', i));
    }

    // ---------- Selection ----------
    function select(p: string | null, opts: { scroll?: boolean; hash?: boolean } = {}) {
      selected = p && byPath.has(p) ? p : null;
      render();
      if (opts.hash !== false) {
        try {
          const url = new URL(location.href);
          url.hash = '';
          if (selected) url.searchParams.set('focus', selected);
          else url.searchParams.delete('focus');
          history.replaceState(null, '', url);
        } catch {
          /* ignore */
        }
      }
      if (selected && opts.scroll && origin === 'ov') {
        const o = oels.get(selected)!;
        ovScroll.scrollTo({ left: Math.max(0, parseFloat(o.style.left) - ovScroll.clientWidth / 2), behavior: 'smooth' });
        const r = ovSection.getBoundingClientRect();
        if (r.top < 0 || r.top > innerHeight * 0.6) ovSection.scrollIntoView({ block: 'start', behavior: 'smooth' });
      } else if (selected && opts.scroll) {
        const a = els.get(selected)!;
        const r = a.getBoundingClientRect();
        if (r.top < 80 || r.bottom > innerHeight - 40) a.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        if (!root.classList.contains('is-side')) {
          const dr = detail.getBoundingClientRect();
          if (dr.bottom > innerHeight) detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      }
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const onode = target.closest<HTMLAnchorElement>('.sm-onode');
      if (onode && !e.metaKey && !e.ctrlKey && !e.shiftKey && e.button === 0) {
        e.preventDefault();
        origin = 'ov';
        select(onode.dataset.p === selected ? null : onode.dataset.p!, { scroll: false });
        if (selected && detail.parentElement !== ovCanvas) detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }
      if (target.closest('[data-close]')) {
        select(null);
        return;
      }
      if (target.closest('[data-sm-full]')) {
        toggleFull();
        return;
      }
      const node = target.closest<HTMLAnchorElement>('.sm-node');
      if (node && !e.metaKey && !e.ctrlKey && !e.shiftKey && e.button === 0) {
        e.preventDefault();
        origin = 'list';
        select(node.dataset.p === selected ? null : node.dataset.p!, { scroll: false });
        if (!root.classList.contains('is-side') && selected) detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }
      const go = target.closest<HTMLElement>('[data-go]');
      if (go) {
        origin = 'ov';
        select(go.dataset.go!, { scroll: true });
        return;
      }
      if (target.closest('[data-toggle]') && selected) {
        setLearned(selected, !learned(selected));
        return;
      }
      if (target.closest('[data-sm-export]')) {
        const dump: Record<string, unknown> = {};
        for (const k of PORTABLE) {
          try {
            const v = localStorage.getItem(k);
            if (v !== null) dump[k] = JSON.parse(v);
          } catch {
            /* skip unreadable keys */
          }
        }
        dump[PROGRESS_KEY] = loadProgress();
        const file = { app: 'system-design-primer', v: 1, exported: new Date().toISOString(), data: dump };
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([JSON.stringify(file, null, 1)], { type: 'application/json' }));
        a.download = `system-design-progress-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        ioMsg.textContent = t.io.saved;
        return;
      }
      if (target.closest('[data-sm-import]')) {
        fileInput.click();
        return;
      }
      if (target.closest('[data-sm-reset]')) {
        const msg = (target.closest('[data-sm-reset]') as HTMLElement).dataset.confirm!;
        if (!window.confirm(msg)) return;
        saveProgress({ v: 1, learned: {}, visited: {}, activities: {}, migrated: true });
      }
    });
    const fileInput = root.querySelector<HTMLInputElement>('[data-sm-file]')!;
    const ioMsg = root.querySelector<HTMLElement>('[data-sm-io-msg]')!;
    fileInput.addEventListener('change', async () => {
      const f = fileInput.files?.[0];
      fileInput.value = '';
      if (!f) return;
      try {
        const file = JSON.parse(await f.text());
        const data = file?.data;
        const prog = data?.[PROGRESS_KEY];
        if (file?.app !== 'system-design-primer' || !prog || prog.v !== 1 || typeof prog.learned !== 'object') throw new Error('bad');
        if (!window.confirm(t.io.replace)) return;
        for (const k of PORTABLE) {
          if (k === PROGRESS_KEY || !(k in data)) continue;
          try {
            localStorage.setItem(k, JSON.stringify(data[k]));
          } catch {
            /* storage unavailable */
          }
        }
        if (data['sdp-map-skin'] === 'grim' || data['sdp-map-skin'] === 'classic') root.dataset.skin = data['sdp-map-skin'];
        if (typeof data['sdp-map-plan'] === 'string' && radios.some((r) => r.value === data['sdp-map-plan'])) plan = data['sdp-map-plan'];
        for (const r of [...radios, ...root.querySelectorAll<HTMLInputElement>('input[name="sm-skin"]')]) r.checked = r.value === plan || r.value === root.dataset.skin;
        saveProgress({ v: 1, learned: prog.learned ?? {}, visited: prog.visited ?? {}, activities: prog.activities ?? {}, last: prog.last, migrated: true });
        ioMsg.textContent = t.io.loaded;
      } catch {
        ioMsg.textContent = t.io.bad;
      }
    });
    const fullBtn = root.querySelector<HTMLButtonElement>('[data-sm-full]')!;
    // Full screen: the browser's own when allowed, else a fixed overlay above the page.
    const setFull = (on: boolean) => {
      ovSection.classList.toggle('is-full', on);
      document.documentElement.classList.toggle('sm-noscroll', on && !document.fullscreenElement);
      fullBtn.setAttribute('aria-pressed', String(on));
      root.querySelector('[data-sm-full-label]')!.textContent = on ? fullBtn.dataset.off! : fullBtn.dataset.on!;
      render();
      fitOverview();
    };
    async function toggleFull(force?: boolean) {
      const on = force ?? !ovSection.classList.contains('is-full');
      if (on) {
        try {
          await ovSection.requestFullscreen();
        } catch {
          /* not allowed here (e.g. inside a frame): use the overlay */
        }
        setFull(true);
      } else {
        if (document.fullscreenElement) await document.exitFullscreen().catch(() => {});
        setFull(false);
      }
    }
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && ovSection.classList.contains('is-full')) setFull(false);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (selected) select(null);
      else if (ovSection.classList.contains('is-full')) toggleFull(false);
    });
    const skins = [...root.querySelectorAll<HTMLInputElement>('input[name="sm-skin"]')];
    for (const r of skins) {
      r.checked = r.value === (root.dataset.skin || 'classic');
      r.addEventListener('change', () => {
        if (!r.checked) return;
        root.dataset.skin = r.value;
        try {
          localStorage.setItem('sdp-map-skin', r.value);
        } catch {
          /* storage unavailable */
        }
        render();
      });
    }
    for (const r of radios) {
      r.checked = r.value === plan;
      r.addEventListener('change', () => {
        if (!r.checked) return;
        plan = r.value;
        writePlan(plan);
        render();
      });
    }

    // Overview: shrink slightly to fit when it is only a little wider than its box; otherwise scroll.
    const fitOverview = () => {
      ovCanvas.style.zoom = '';
      const f = ovScroll.clientWidth / ovCanvas.offsetWidth;
      if (f < 1 && f >= 0.8) ovCanvas.style.zoom = String(Math.floor(f * 100) / 100);
    };
    new ResizeObserver(fitOverview).observe(ovScroll);

    // Layout mode: side panel when the map is wide enough.
    const setMode = () => {
      const side = root.clientWidth >= 880;
      if (side !== root.classList.contains('is-side')) {
        root.classList.toggle('is-side', side);
        render();
      } else requestAnimationFrame(drawWires);
    };
    new ResizeObserver(setMode).observe(root);
    document.fonts?.ready.then(() => requestAnimationFrame(drawWires));
    onProgressChange(render);

    // Initial selection: ?focus=path (or the older #focus=path), else where the reader is.
    const asked = new URLSearchParams(location.search).get('focus') ?? /#focus=([\w\-/]+\/)/.exec(location.hash)?.[1] ?? null;
    const m = asked && byPath.has(asked) ? asked : null;
    root.classList.toggle('is-side', root.clientWidth >= 880);
    // Open a topic only when the link asked for one; otherwise show the whole map, with
    // "you are here" marked and the view scrolled to it.
    origin = 'ov';
    select(m, { hash: false, scroll: !!m });
    const here = progress.last && oels.get(progress.last);
    if (!m && here) ovScroll.scrollLeft = Math.max(0, parseFloat(here.style.left) - ovScroll.clientWidth / 2);
  }

  document.querySelectorAll<HTMLElement>('[data-sm]').forEach(init);
</script>
